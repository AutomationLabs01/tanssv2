# =============================================================================
# TANSS RAG Stack – Docker .env Vorlage
# =============================================================================
# 1. Secrets automatisch generieren:  ./scripts/generate-secrets.sh
# 2. Externe Credentials manuell eintragen (TANSS, S1, OpenAI)
# 3. NIEMALS diese Datei oder .env in Git einchecken!
# =============================================================================


# =============================================================================
# Netzwerk und Domain
# =============================================================================
# Öffentliche Domain (für TLS-Zertifikat und CORS)
DOMAIN=deine-domain.de

# Externe URL der Supabase API (über Nginx erreichbar)
API_EXTERNAL_URL=https://deine-domain.de

# URL der Frontend-Anwendung (für CORS-Allowlist)
SITE_URL=https://deine-domain.de

# n8n öffentliche URL (für Webhook-Callbacks)
WEBHOOK_URL=https://deine-domain.de/webhook

# n8n Host und Protokoll
N8N_HOST=deine-domain.de
N8N_PROTOCOL=https

# Supabase interne URL (n8n → Kong, innerhalb Docker-Netz)
SUPABASE_INTERNAL_URL=http://kong:8000


# =============================================================================
# PostgreSQL – Datenbankzugänge
# =============================================================================
# Generiert von generate-secrets.sh – bitte nicht manuell setzen

POSTGRES_DB=postgres
POSTGRES_USER=supabase_admin

# Hauptpasswort (supabase_admin)
POSTGRES_PASSWORD=

# PostgREST authenticator-Rolle
POSTGRES_PASSWORD_AUTHENTICATOR=

# Storage-Rolle
POSTGRES_PASSWORD_STORAGE=

# n8n-Datenbankbenutzer
POSTGRES_PASSWORD_N8N=

# Backup-Verschlüsselung (optional, für backup-db.sh)
BACKUP_ENCRYPTION_KEY=

# Datenspeicher-Pfad auf dem Host (absolute Pfade empfohlen)
DATA_DIR=./data


# =============================================================================
# Supabase JWT und Sessions
# =============================================================================
# Generiert von generate-secrets.sh – bitte nicht manuell setzen

# JWT-Secret (>= 40 Zeichen, base64-safe)
JWT_SECRET=

# JWT-Ablaufzeit in Sekunden (Standard: 1 Stunde)
JWT_EXP=3600

# Supabase anon Key (JWT mit role=anon)
ANON_KEY=

# Supabase service_role Key (JWT mit role=service_role, bypasses RLS)
SERVICE_ROLE_KEY=

# Supabase Realtime Verschlüsselungskey
REALTIME_DB_ENC_KEY=

# Elixir/Phoenix Secret Key Base (für Realtime)
SECRET_KEY_BASE=


# =============================================================================
# n8n Konfiguration
# =============================================================================
# Generiert von generate-secrets.sh – bitte nicht manuell setzen

# Verschlüsselungsschlüssel für gespeicherte Credentials
N8N_ENCRYPTION_KEY=

# Admin-Login für n8n Web-UI
N8N_BASIC_AUTH_USER=admin
N8N_BASIC_AUTH_PASSWORD=

# Signup deaktivieren (nur in Prod, wenn User-Management nicht benötigt)
DISABLE_SIGNUP=false


# =============================================================================
# TANSS (manuell eintragen)
# =============================================================================
TANSS_BASE_URL=https://deine-instanz.tanss.de
TANSS_USERNAME=api-user
TANSS_PASSWORD=
TANSS_API_KEY=

# TOTP-Secret für 2FA (optional, Base32-kodiert)
TANSS_TOTP_SECRET=


# =============================================================================
# Systemhaus.ONE / SAP B1 (manuell eintragen)
# =============================================================================
S1_BASE_URL=https://dein-server:50000
S1_USERNAME=api-user
S1_PASSWORD=
S1_COMPANY_DB=S1_PROD
S1_DEFAULT_TAX_CODE=T1


# =============================================================================
# OpenAI (manuell eintragen)
# =============================================================================
OPENAI_API_KEY=sk-...


# =============================================================================
# E-Mail / SMTP (für Supabase Auth)
# =============================================================================
# Leer lassen um E-Mail-Versand zu deaktivieren
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SENDER_NAME=TANSS RAG
# E-Mail-Bestätigung automatisch (nur Entwicklung!)
MAILER_AUTOCONFIRM=false


# =============================================================================
# Benachrichtigungen
# =============================================================================
SLACK_WEBHOOK_URL=


# =============================================================================
# Storage
# =============================================================================
# Max. Upload-Größe in Bytes (Standard: 50MB)
STORAGE_FILE_SIZE_LIMIT=52428800


# =============================================================================
# Dev-only (nur für docker-compose.dev.yml)
# =============================================================================
PGADMIN_EMAIL=admin@local.dev
PGADMIN_PASSWORD=admin
