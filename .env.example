# =============================================================================
# TANSS → Systemhaus.ONE Angebots-Automatisierung mit RAG
# Umgebungsvariablen-Vorlage
# =============================================================================
# Kopiere diese Datei nach .env und befülle alle Felder:
#   cp .env.example .env
#
# WICHTIG: .env niemals in Git einchecken! Stelle sicher dass .env
# in .gitignore eingetragen ist.
# =============================================================================


# =============================================================================
# TANSS
# =============================================================================
# Basis-URL deiner TANSS-Instanz (kein trailing slash, kein /api/v1 am Ende)
TANSS_BASE_URL=https://deine-instanz.tanss.de

# Dedizierter API-User für den Workflow (kein Admin-Account erforderlich)
# Der User braucht: Tickets lesen, Kommentare schreiben
TANSS_USERNAME=api-user

# Passwort des API-Users
TANSS_PASSWORD=

# Wie oft der Workflow prüft ob neue #angebot-Kommentare vorhanden sind
# Wert in Minuten (muss mit dem Schedule-Trigger im Workflow übereinstimmen)
TANSS_POLL_INTERVAL_MINUTES=3

# Hashtag der einen Angebots-Workflow auslöst (case-insensitive)
# Mehrere Hashtags: Im Workflow-Code anpassen (Array TRIGGER_TAGS)
TANSS_TRIGGER_HASHTAG=#angebot

# Optional: TOTP-Secret für 2FA-Authentifizierung (Base32-kodiert)
# Leer lassen wenn kein 2FA aktiv ist
TANSS_TOTP_SECRET=


# =============================================================================
# Systemhaus.ONE / SAP Business One Service Layer
# =============================================================================
# URL des SAP B1 Servers mit Port (Standard: 50000)
# Format: https://hostname:50000 (KEIN trailing slash)
S1_BASE_URL=https://dein-server:50000

# SAP B1 Benutzername (hat Berechtigung Angebote zu erstellen)
S1_USERNAME=api-user

# SAP B1 Passwort
S1_PASSWORD=

# Name der SAP B1 Firmendatenbank (in SAP B1 Administration → Unternehmen)
S1_COMPANY_DB=S1_PROD

# Standard-Steuerschlüssel für alle Angebotspositionen
# In SAP B1: Administration → Einrichten → Finanzen → Steuern → Steuerdefinition
S1_DEFAULT_TAX_CODE=T1

# Optional: Freitext-Artikelnummer falls kein ItemCode bekannt ist
# Muss in SAP B1 als Artikel angelegt sein (Art: Dienstleistung)
# Leer lassen = SAP B1 nutzt Freitext ohne ItemCode (abhängig von S1-Konfiguration)
S1_FREITEXT_ITEM_CODE=


# =============================================================================
# Supabase
# =============================================================================
# Basis-URL deines Supabase-Projekts
# Zu finden unter: Project Settings → API → Project URL
SUPABASE_URL=https://dein-projekt.supabase.co

# Anon Key (öffentlicher Schlüssel, nur Lesezugriff mit RLS)
# Zu finden unter: Project Settings → API → anon public
SUPABASE_ANON_KEY=

# Service Role Key (privater Schlüssel, Schreibzugriff ohne RLS)
# Zu finden unter: Project Settings → API → service_role
# NIEMALS im Frontend oder Client-Code verwenden!
SUPABASE_SERVICE_ROLE_KEY=


# =============================================================================
# OpenAI
# =============================================================================
# OpenAI API Key (beginnt mit sk-)
# Zu finden unter: platform.openai.com → API Keys
OPENAI_API_KEY=sk-...

# LLM-Modell für Kommentar-Parsing und RAG-Vollständigkeitsprüfung
# Empfohlen: gpt-4o (beste Qualität) oder gpt-4o-mini (günstiger, etwas schlechter)
OPENAI_MODEL=gpt-4o

# Embedding-Modell für Similarity Search
# text-embedding-3-small: 1536 Dim, günstig, gut für DE
# text-embedding-3-large: 3072 Dim, besser für EN, 3x teurer
OPENAI_EMBEDDING_MODEL=text-embedding-3-small


# =============================================================================
# Benachrichtigungen (optional, aber empfohlen)
# =============================================================================
# Slack Incoming Webhook URL für Fehler-Benachrichtigungen und Ingestion-Reports
# Leer lassen um Slack-Benachrichtigungen zu deaktivieren
# Erstellen unter: api.slack.com/apps → Incoming Webhooks
SLACK_WEBHOOK_URL=

# E-Mail-Adresse für Fehler-Benachrichtigungen (benötigt separaten E-Mail-Node in n8n)
# Derzeit nicht im Workflow implementiert – als Erweiterungspunkt gedacht
NOTIFICATION_EMAIL=


# =============================================================================
# n8n interne Einstellungen (nur bei self-hosted n8n relevant)
# =============================================================================
# Diese Variablen werden in der n8n docker-compose.yml gesetzt,
# nicht direkt im Workflow genutzt

# Zeitzone für Schedule-Trigger (Standard: Europe/Berlin)
# GENERIC_TIMEZONE=Europe/Berlin

# Executions speichern (für Debugging)
# EXECUTIONS_DATA_SAVE_ON_SUCCESS=all
# EXECUTIONS_DATA_SAVE_ON_ERROR=all
# EXECUTIONS_DATA_MAX_AGE=336  # 2 Wochen in Stunden
