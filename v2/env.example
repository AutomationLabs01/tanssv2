# Tanss API Konfiguration
# Kopieren Sie diese Datei zu .env und füllen Sie die Werte aus

TANSS_API_BASE_URL=https://api.tanss.de
TANSS_API_KEY=your-api-key-here

# Test-Modus: Wenn kein TANSS_API_KEY gesetzt ist, läuft der Server automatisch im Test-Modus
# Im Test-Modus werden Mock-Daten zurückgegeben, sodass Sie den Server ohne API-Zugriff testen können
# Sie können auch explizit TEST_MODE=true setzen, um den Test-Modus zu aktivieren
# TEST_MODE=true

